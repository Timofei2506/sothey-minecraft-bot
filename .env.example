# Copy to .env for local use. Never commit .env or a real password.
MC_HOST=exvxeldo.de5.net
MC_PORT=21734
MC_USERNAME=Sothey
MC_PASSWORD=
# One local session; Actions uses two separate 4-hour sessions for a night.
BOT_RUN_SECONDS=14400
BOT_MIN_READY_SECONDS=30
BOT_JOIN_TIMEOUT_SECONDS=180
# Warning threshold only; outages no longer terminate the session.
BOT_MAX_OFFLINE_SECONDS=900

# Infrequent arm animation/held-slot selection; 0 disables it.
BOT_IDLE_ACTIVITY_SECONDS=45
BOT_EXPECT_NEW_ACCOUNT=false

BOT_AUTH_PROBE_DELAY_SECONDS=12
BOT_AUTH_PROBE_REPEAT_SECONDS=30
BOT_AUTH_DIAGNOSTICS=false
# Optional absolute Unix deadline. Leave empty for BOT_RUN_SECONDS.
BOT_DEADLINE_EPOCH=

# Continuous walking around the anchor. 0 disables it.
# Radius is decided by the spawn block: 2 over gold ore, 5 over anything else.
WANDER_RADIUS_BLOCKS=0
# Pause between legs, seconds. 0 = walk with no pause.
WANDER_PAUSE_SECONDS=1
# Jump every N legs. 0 = never jump.
WANDER_JUMP_EVERY_LEGS=3
# Optional explicit anchor "x,y,z". Empty = use the position at the first ready moment,
# and re-anchor automatically after an admin teleport.
WANDER_ANCHOR=
